# Cloud Cars - Environment Variables for Railway

# Database (automatically provided by Railway when you connect MySQL service)
DATABASE_URL=mysql://user:password@host:port/database

# Security
JWT_SECRET=CloudCars2024SecureRandomStringForJWTTokens!ChangeThis123
NODE_ENV=production

# Mailgun Email Service
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_DOMAIN=mg.cloudcarsltd.com
MAILGUN_API_BASE_URL=https://api.eu.mailgun.net

# AWS S3 Storage (for image uploads in CMS)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-2
AWS_S3_BUCKET=cloudcars-uploads

# Esendex SMS (customer account links)
ESENDEX_ACCOUNT_REFERENCE=EX0123456
ESENDEX_USERNAME=your-esendex-account-email
ESENDEX_PASSWORD=your-esendex-password
# Registered UK sender ID (max 11 alphanumeric chars) — must already be
# registered on the Esendex account or UK carriers will silently block it.
ESENDEX_SENDER_ID=CloudCars

# Optional: driver app download link emailed to approved drivers.
# Defaults to https://book.cloudcarsltd.com/driver-ws/v2/apk if unset.
DRIVER_APP_DOWNLOAD_URL=https://book.cloudcarsltd.com/driver-ws/v2/apk

# Secret shared with an external scheduler (e.g. Railway Cron Job,
# cron-job.org, GitHub Actions) that triggers the daily driver onboarding
# reminder sweep. Trigger with:
#   curl -X POST https://cloudcarsltd.com/api/trpc/admin.runAutoOnboardingReminders \
#     -H "Content-Type: application/json" \
#     -d '{"json":{"key":"<CRON_KEY value>"}}'
CRON_KEY=generate-a-long-random-string-here

# Server Configuration
PORT=8080
